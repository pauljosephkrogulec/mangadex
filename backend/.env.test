# Test environment configurations
# Override sensitive values for testing

###> lexik/jwt-authentication-bundle ###
# Use a simple test passphrase
JWT_PASSPHRASE=testpass123
###< lexik/jwt-authentication-bundle ###

###> symfony/framework-bundle ###
APP_SECRET=test_secret_12345678901234567890
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
###< doctrine/doctrine-bundle ###

###> App User for testing ###
# This will be used by the test client for authentication
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123
