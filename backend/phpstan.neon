parameters:
    level: max
    
    ignoreErrors:
        # Missing generic types on Doctrine Collections - can be fixed gradually
        - message: "#Property .* with generic interface Doctrine\\\\Common\\\\Collections\\\\Collection does not specify its types#"
        
        # getGroups() return type in DataFixtures - low priority
        - message: "#Method .*::getGroups\\(\\) return type has no value type specified in iterable type array.#"
          path: src/DataFixtures/*
        
        # DataFixtures read from JSON which returns mixed types - safe to ignore
        - message: '#Parameter .* expects .*, mixed given.#'
          path: src/DataFixtures/*
        - message: '#Argument of an invalid type mixed supplied for foreach, only iterables are supported.#'
          path: src/DataFixtures/*
        - message: '#Binary operation .* between .* and mixed results in an error.#'
          path: src/DataFixtures/*

        # getParameter() returns mixed, concatenation with string causes binaryOp.invalid
        - message: '#Binary operation .* between .* and .* results in an error.#'
          path: src/Controller/*
        
        # realpath() expects string, getParameter() returns mixed
        - message: "#Parameter .* of function realpath expects string, mixed given.#"
          path: src/Controller/*

        # Autowire attribute - PHPStan doesn't fully understand Symfony attributes
        - message: "#Attribute class .* does not have the method target.#"
          path: src/DataFixtures/*

        # property.onlyWritten for $customLists in User/Manga - false positive, it's used via getter
        - message: "#Property App\\\\Entity\\\\(User|Manga)::\\$customLists is never read, only written.#"

        # Redundant is_array() checks - PHPDoc type narrowing
        - message: "#Call to function is_array\\(\\) with array<.*> will always evaluate to true.#"

        # Instanceof always true - PHPDoc type narrowing
        - message: "#Instanceof between .* and .* will always evaluate to true.#"

        # Unreachable statement - after return in if block
        - message: "#Unreachable statement - code above always terminates.#"

        # nullCoalesce.expr - false positive after empty() check
        - message: "#Expression on left side of .* is not nullable.#"
          path: src/State/MangaFeedProvider.php

        # ProcessorInterface generic types in process() method calls
        - message: "#Parameter .*data of method ApiPlatform\\\\State\\\\ProcessorInterface<.*>::process\\(\\) expects .*, .* given.#"
        
    # Include paths
    paths:
        - src
