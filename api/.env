# Valeurs par défaut des variables d'environnement de l'API (voir docs/configuration.md).
#
# Fichiers chargés, du moins prioritaire au plus prioritaire :
#   .env                  valeurs par défaut, versionné (ce fichier)
#   .env.local            surcharges locales, NON versionné
#   .env.$APP_ENV         valeurs propres à un environnement (dev, test), versionné
#   .env.$APP_ENV.local   surcharges locales par environnement, NON versionné
# Les vraies variables d'environnement (Docker Compose, Render, CI) l'emportent toujours sur ces fichiers.
#
# Staging et prod : AUCUN secret dans un fichier versionné ni dans l'image Docker.
# Ils sont définis uniquement comme variables d'environnement de la plateforme (Render, GitHub Environments).
# Pas de Vault Symfony : staging et prod partagent la même image en APP_ENV=prod (cf. issue #25).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> version déployée (GET /api/health) ###
# Injectée au build de l'image de staging/prod (commit ou tag). `dev` en local.
APP_VERSION=dev
###< version déployée ###

###> proxys de confiance (config/packages/framework.yaml) ###
# Vide = aucun proxy de confiance. Render : REMOTE_ADDR.
TRUSTED_PROXIES=
###< proxys de confiance ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
