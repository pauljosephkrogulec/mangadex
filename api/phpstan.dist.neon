# PHPStan (issue #17). Les extensions (symfony, phpunit, deprecation-rules) sont chargées
# automatiquement par phpstan/extension-installer.
# Surcharge locale possible dans phpstan.neon (non versionné), qui inclut ce fichier.
parameters:
    level: max
    paths:
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Fichier généré par Symfony (référence de configuration), pas du code applicatif.
        - config/reference.php
    tmpDir: var/cache/phpstan

    # Contrôles plus stricts que le niveau max par défaut.
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

    # phpstan-symfony : le conteneur compilé permet de typer $container->get(), les paramètres, etc.
    # Généré par `bin/console cache:warmup` (env dev), ce que fait tout démarrage de l'app en dev.
    # Le temps passe par Symfony\Component\Clock\ClockInterface (issue #23) : sinon impossible
    # de figer ou d'avancer l'heure dans les tests (MockClock, ClockSensitiveTrait::mockTime()).
    # Une date explicite reste permise : `new \DateTimeImmutable('2026-01-01')`.
    disallowedFunctionCalls:
        -
            function:
                - 'time()'
                - 'microtime()'
                - 'hrtime()'
                - 'date_create()'
                - 'date_create_immutable()'
            message: 'injecter Symfony\Component\Clock\ClockInterface et utiliser $clock->now()'
        -
            function: 'date()'
            message: 'injecter ClockInterface et formater $clock->now()'
            allowParamsAnywhereAnyValue:
                -
                    position: 2
                    name: 'timestamp'
    disallowedMethodCalls:
        -
            method: 'DateTimeImmutable::__construct()'
            message: 'injecter ClockInterface et utiliser $clock->now() (une date explicite reste permise)'
            allowParamsAnywhereAnyValue:
                -
                    position: 1
                    name: 'datetime'
        -
            method: 'DateTime::__construct()'
            message: 'DateTime est mutable : utiliser DateTimeImmutable, et ClockInterface pour « maintenant »'

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
