# Variables lues par Docker Compose (compose.yaml, compose.override.yaml).
# Pour surcharger en local : copier ce fichier en `.env` (non versionné), puis décommenter/modifier.
# Toutes ont une valeur par défaut : ce fichier est optionnel. Voir docs/configuration.md.

# Port publié sur l'hôte par le reverse proxy Caddy (http://localhost:<port>).
# HTTP_PORT=80

# PostgreSQL local (image postgres:<version>-alpine). Utilisé aussi pour construire DATABASE_URL de l'API.
# POSTGRES_VERSION=16
# POSTGRES_DB=app
# POSTGRES_USER=app
# POSTGRES_PASSWORD=!ChangeMe!

# UID/GID de l'utilisateur du conteneur php (dev) : à aligner sur `id -u` / `id -g` si ≠ 1000.
# UID=1000
# GID=1000

# Xdebug (dev) : off | debug | coverage | develop | profile
# XDEBUG_MODE=off

# Stockage objet S3 (RustFS) : identifiants root, transmis aussi à l'API.
# S3_ACCESS_KEY=mangadex
# S3_SECRET_KEY=!ChangeMe!

# Mercure : clé HMAC des JWT, émetteur de confiance (iss) et URL publique du hub (= audience des JWT).
# MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
# MERCURE_JWT_ISSUER=http://localhost
# MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure

# Ports des interfaces web de dev : Mailpit et console RustFS.
# MAILPIT_PORT=8025
# STORAGE_CONSOLE_PORT=9001
